# PostgreSQL connection string
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/citycare

# JWT signing secret (required - use a long random string)
JWT_SECRET=

# Backend HTTP / Socket.IO port
PORT=3000

# OpenAI API key (optional - falls back to canned AI responses if unset)
OPENAI_API_KEY=

# Frontend origin(s) allowed for CORS / websocket (comma-separated for multiple)
FRONTEND_URL=https://citycare-hms.vercel.app,http://localhost:5173

# Super-admin login credentials (required for admin dashboard access)
ADMIN_EMAIL=
ADMIN_PASSWORD=
